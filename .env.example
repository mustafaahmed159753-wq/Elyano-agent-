PORT=6050
HOST=0.0.0.0
USE_HTTPS=true
AGENT_DATA_DIR=./data
AGENT_CERT_DIR=./certs
AGENT_CERT_HOST=10.11.0.190

# Supply this only for unattended first-time admin provisioning.
# Otherwise, the first-run setup screen lets you create a strong admin password.
BOOTSTRAP_ADMIN_PASSWORD=

# Optional converter binaries. Defaults are soffice and gs on Linux.
LIBREOFFICE_PATH=soffice
GHOSTSCRIPT_PATH=gs
MAX_UPLOAD_MB=40
